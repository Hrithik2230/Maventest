@Library('cicdlibrary')_

pipeline
{
    agent any
    stages
    {
        stage('ContDownload')
        {
            steps
            {
              script
              {
                cicd.gitDownload('maven')  
              }
            }
        }
        stage('ContBuild')
        {
            steps
            {
              script
              {
                cicd.newBuild() 
              }
            }
        }
    }
}
